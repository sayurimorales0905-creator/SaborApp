<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sabor_crema">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sabor_naranja"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/white"
        app:title="@string/reportes_titulo"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Reporte Principal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sabor_gris_borde"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reportes_venta_hoy"
                        android:textColor="@color/sabor_gris_texto"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvVentaTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="S/ 1,240.00"
                        android:textColor="@color/sabor_rojo"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- Stat cards side by side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Stat 1: Pedidos -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/sabor_gris_borde"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/sabor_crema">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingHorizontal="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/reportes_pedidos"
                                    android:textColor="@color/sabor_gris_texto"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvPedidosCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="42"
                                    android:textColor="@color/sabor_negro"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Stat 2: Ticket prom. -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/sabor_gris_borde"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/sabor_crema">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingHorizontal="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/reportes_ticket_prom"
                                    android:textColor="@color/sabor_gris_texto"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvTicketPromedio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="S/ 29.50"
                                    android:textColor="@color/sabor_negro"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Platos más pedidos -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/reportes_mas_pedidos"
                        android:textColor="@color/sabor_negro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Item 1: 1/4 de pollo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="1/4 de pollo"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="12dp"
                            android:layout_weight="1"
                            android:progress="85"
                            app:trackCornerRadius="6dp"
                            app:trackColor="@color/sabor_gris_fondo"
                            app:indicatorColor="@color/sabor_naranja" />

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="38"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Item 2: Lomo saltado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="Lomo saltado"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="12dp"
                            android:layout_weight="1"
                            android:progress="60"
                            app:trackCornerRadius="6dp"
                            app:trackColor="@color/sabor_gris_fondo"
                            app:indicatorColor="@color/sabor_naranja" />

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="24"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Item 3: Chicha 1 L -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="Chicha 1 L"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="12dp"
                            android:layout_weight="1"
                            android:progress="45"
                            app:trackCornerRadius="6dp"
                            app:trackColor="@color/sabor_gris_fondo"
                            app:indicatorColor="@color/sabor_naranja" />

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="19"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Item 4: Ceviche -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="Ceviche"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="12dp"
                            android:layout_weight="1"
                            android:progress="30"
                            app:trackCornerRadius="6dp"
                            app:trackColor="@color/sabor_gris_fondo"
                            app:indicatorColor="@color/sabor_naranja" />

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="11"
                            android:textColor="@color/sabor_negro"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Botón Compartir Resumen -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompartirResumen"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/reportes_compartir"
                        android:textColor="@color/sabor_rojo"
                        app:strokeColor="@color/sabor_rojo"
                        app:cornerRadius="25dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>